# Ambiente de DESARROLLO. Copiar a .env.development (no se versiona) y completar.
# Los secretos de desarrollo nunca se reutilizan en producción.
# Generar cada secreto con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
SWAGGER_ENABLED=true

# Usuario de la app (solo SELECT/INSERT/UPDATE/DELETE). Contraseña = APP_DB_PASSWORD de .env.db
DATABASE_URL=postgresql://ecuatravel_app:<APP_DB_PASSWORD>@localhost:5433/booking_db
# Usuario migrador (dueño del esquema). Solo lo usa `npm run migration:run`.
DATABASE_MIGRATIONS_URL=postgresql://ecuatravel_migrator:<MIGRATOR_DB_PASSWORD>@localhost:5433/booking_db
DB_SSL=false
DB_SYNCHRONIZE=false
DB_POOL_MAX=10

# Mínimo 32 caracteres; los tres deben ser distintos.
JWT_SECRET=
JWT_EXPIRES_IN=1h
BOOKING_API_KEY=
VOUCHER_SECRET=

# CORS: en desarrollo también se aceptan localhost y la IP de Tailscale.
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=
PARTNER_SERVICE_ID=NODE_ATR_DEV

# Integración con Booking (opcional en local). Vacío = no se envía stock ni check-in.
BOOKING_STOCK_TRANSPORT=
BOOKING_HUB_REST_URL=
BOOKING_REST_STOCK_URL=
BOOKING_GRPC_URL=
BOOKING_STOCK_API_KEY=
BOOKING_HUB_GRPC_HOST=
BOOKING_HUB_GRPC_PORT=50051
BOOKING_HUB_GRPC_TLS=false
BOOKING_GRPC_SYNC_DIAS=0
BOOKING_CENTRAL_URL=
BOOKING_CENTRAL_API_KEY=
RABBITMQ_URL=
