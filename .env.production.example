# Ambiente de PRODUCCIÓN. Estas variables se cargan en el panel del proveedor
# (Azure App Service, etc.) o en un gestor de secretos, no en un archivo dentro
# del servidor ni del repositorio. La app no arranca si alguna regla falla
# (ver src/config/env.validation.ts).
NODE_ENV=production
HOST=0.0.0.0
PORT=3001
# Swagger apagado por defecto en producción.
SWAGGER_ENABLED=false

# Base administrada (no local), con SSL y verificación del certificado.
DATABASE_URL=postgresql://ecuatravel_app:<clave>@<host-produccion>:5432/<base>
DB_SSL=true
DB_SSL_CA=<PEM de la CA en una línea con \n>
DB_SYNCHRONIZE=false
DB_POOL_MAX=10
# DATABASE_MIGRATIONS_URL NO va aquí: solo la recibe el job de migraciones del CI/CD.

# Secretos propios de producción (distintos de desarrollo), 32+ caracteres.
JWT_SECRET=<generar>
JWT_EXPIRES_IN=15m
BOOKING_API_KEY=<entregada por el equipo de Booking>
VOUCHER_SECRET=<generar>

# Solo orígenes HTTPS explícitos.
FRONTEND_URL=https://<dominio-del-frontend>
CORS_ORIGINS=
PARTNER_SERVICE_ID=NODE_ATR_ARIEL

BOOKING_STOCK_TRANSPORT=rest
BOOKING_HUB_REST_URL=
BOOKING_STOCK_API_KEY=
BOOKING_CENTRAL_URL=
BOOKING_CENTRAL_API_KEY=
RABBITMQ_URL=
